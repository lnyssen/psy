// Schéma de la base — outil de gestion de pratique (Amandine Monsel, psychologue)
//
// Conventions reprises de planning-studios : modèles et champs en anglais
// (écosystème Prisma/TypeScript), tables et colonnes SQL en snake_case pour
// rester lisible en psql, commentaires métier en français.
//
// Périmètre de ce premier jet : strictement ce qu'il faut pour éprouver la
// chaîne Neon + Vercel de bout en bout. Le modèle complet (attestations,
// charges, récurrences, jours fériés) viendra avec les phases 2 à 4 du brief,
// et seulement après l'entretien avec l'utilisatrice.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion ne vit plus ici mais dans prisma.config.ts
// (pour la CLI) et dans src/lib/db.ts (pour l'application, via l'adaptateur
// @prisma/adapter-pg).
datasource db {
  provider = "postgresql"
}

/// Les deux régimes qui coexistent dans la même semaine. C'est la distinction
/// la plus structurante du projet : ils ne se facturent pas de la même façon.
/// Le détail exact du circuit conventionné reste à établir avec l'utilisatrice
/// (voir RESEARCH_PLAN.md, objectif 3) — d'où l'absence, ici, de tout champ
/// sur les quotas ou le destinataire de la facturation.
/// Qui paie la séance. Deux régimes seulement :
///
/// - PRIVE : le patient paie le tarif de sa fiche ;
/// - CONVENTIONNE : psychologue de première ligne (PPL). Amandine est payée par
///   l'INAMI, le patient ne paie rien — le montant du tarif conventionné est ce
///   que reçoit Amandine, pas ce que doit le patient.
///
/// La facturation à un établissement (l'école) n'est pas un régime de patient :
/// elle vit au niveau du lieu (Cabinet.factureInstitution).
enum CareScheme {
  CONVENTIONNE
  PRIVE
}

/// Statut d'une séance passée. Le brief prévoit qu'un seul geste par séance
/// suffise à le fixer, et que ce statut détermine mécaniquement si l'acte
/// devient facturable : SCHEDULED et CANCELLED_IN_TIME ne le sont pas,
/// ATTENDED et NO_SHOW le sont (une absence non excusée reste due).
enum SessionStatus {
  SCHEDULED
  ATTENDED
  CANCELLED_IN_TIME
  NO_SHOW
  /// Une absence non excusée, mais dont la praticienne a choisi de ne pas
  /// réclamer le montant après coup. Distincte de CANCELLED_IN_TIME : la
  /// trace que c'était une absence reste, pour ses propres statistiques
  /// (« deux absences cette année »), mais isBillable() la traite comme
  /// CANCELLED_IN_TIME — plus due, plus comptée, et un patient conventionné
  /// retrouve la séance dans son quota annuel.
  NO_SHOW_ANNULE
}

/// Comment le paiement est entré. Sert au reçu, qui doit le mentionner.
enum PaymentMethod {
  CASH
  ELECTRONIC
}

/// Seule famille de sens portée par de la couleur pleine dans l'interface
/// (voir la contrainte chromatique du brief) — les autres passent par des
/// traitements non chromatiques doublés de texte.
enum PaymentStatus {
  DUE
  PAID
  OVERDUE
}

/// Les cabinets sont des données, pas une énumération figée dans le code : on
/// doit pouvoir en corriger l'adresse, en ajouter un, en retirer un, sans
/// migration ni déploiement.
///
/// Leur couleur suit la même logique. Elle est choisie dans une palette
/// restreinte (voir src/lib/palette.ts) dont chaque teinte a été vérifiée AA
/// sur les trois usages et tenue à l'écart des couleurs qui portent déjà du
/// sens — les trois états de paiement et le violet de marque.
model Cabinet {
  id          String  @id @default(cuid())
  nom         String  @unique
  addressLine String  @map("address_line")
  postalCode  String  @map("postal_code")
  city        String
  /// Teinte foncée, réservée au texte : elle doit rester lisible sur fond clair.
  colorHex    String  @map("color_hex")
  /// Aplat correspondant.
  fillHex     String  @map("fill_hex")
  /// Teinte vive, pour les filets et les pastilles — tout ce qui ne porte pas
  /// de texte. C'est elle qui donne sa couleur au lieu ; la teinte de texte,
  /// contrainte par le contraste, est forcément plus sourde.
  vividHex    String  @default("#00C8D4") @map("vivid_hex")
  /// Un cabinet fermé n'est plus proposé, mais ses séances passées le gardent.
  actif       Boolean @default(true)
  /// Visible sur le site public et proposé à la réservation. Faux pour un lieu
  /// où l'on ne prend pas rendez-vous — l'école, par exemple, où Amandine
  /// intervient pour l'établissement et non pour une patientèle qui la
  /// solliciterait directement.
  publie      Boolean @default(true)
  /// Comment on vient : lignes de tram, bus et métro, et tout ce qui aide à
  /// trouver la porte. Texte libre et non liste structurée : le réseau change,
  /// une ligne est déviée pour travaux, un étage se précise — Amandine doit
  /// pouvoir corriger sans qu'on touche au code. Une ligne par idée.
  acces       String  @default("") @db.Text
  ordre       Int     @default(0)

  /// Plafond hebdomadaire, en minutes — l'école en a un (24 h), les cabinets
  /// privés n'en ont pas. Null : aucun plafond à surveiller. Ce n'est pas un
  /// horaire d'ouverture (Disponibilite) : c'est un volume convenu avec un
  /// tiers, que l'agenda peut dépasser sans qu'aucun créneau ne le signale de
  /// lui-même.
  quotaHebdoMin      Int?    @map("quota_hebdo_min")
  /// Vrai pour un lieu facturé à un établissement plutôt qu'au patient : la
  /// facture porte alors sur des heures, pas sur des actes individuels.
  factureInstitution Boolean @default(false) @map("facture_institution")
  /// Tarif horaire de cette facturation, en centimes. N'a de sens que si
  /// factureInstitution est vrai ; sinon les tarifs viennent de Tarif ou du
  /// patient.
  tarifHoraireCents  Int?    @map("tarif_horaire_cents")

  /// Nom légal complet de l'établissement facturé, tel qu'il doit apparaître
  /// sur une facture — pas le nom court utilisé partout ailleurs dans
  /// l'outil (« École »). Vide : la facture reprend `nom`.
  raisonSociale       String? @map("raison_sociale")
  /// Mentions légales du client (TVA, RPM…), reprises telles quelles sous
  /// son adresse sur la facture. Texte libre : chaque structure les rédige à
  /// sa façon, et ce n'est pas à l'outil d'en imposer une forme.
  mentionLegaleClient String? @map("mention_legale_client") @db.Text
  /// Préfixe de la communication de paiement portée sur la facture
  /// (« FACE2026/001 » pour le préfixe « FACE »). Vide : « FACT ».
  prefixeReference    String? @map("prefixe_reference")

  sessions       Session[]
  patients       Patient[]
  disponibilites Disponibilite[]
  demandes       DemandeRdv[]
  depenses       Depense[]
  factures       FactureEtablissement[]

  @@map("cabinets")
}

/// Grille tarifaire. Le tarif d'un patient peut s'en écarter — le sien fait
/// foi — mais celui marqué par défaut sert à la création d'une fiche.
model Tarif {
  id          String     @id @default(cuid())
  libelle     String
  /// Régime auquel ce tarif s'applique. En privé c'est ce que paie le patient ;
  /// en conventionné c'est ce que reçoit Amandine de l'INAMI, le patient ne
  /// paie rien.
  regime      CareScheme @default(PRIVE)
  amountCents Int        @map("amount_cents")
  parDefaut   Boolean    @default(false) @map("par_defaut")
  actif       Boolean    @default(true)
  ordre       Int        @default(0)

  patients Patient[]

  @@map("tarifs")
}

/// Horaires d'ouverture, par lieu et par jour de semaine. L'outil savait quand
/// Amandine est occupée ; il lui manquait de savoir quand elle est disponible.
/// Sans cela, aucun créneau ne peut être proposé au public.
model Disponibilite {
  id        String  @id @default(cuid())
  cabinetId String  @map("cabinet_id")
  cabinet   Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  /// 0 = lundi … 4 = vendredi. Le week-end n'est pas proposé.
  jour      Int
  /// Minutes depuis minuit, heure de Bruxelles.
  debutMin  Int     @map("debut_min")
  finMin    Int     @map("fin_min")

  @@index([cabinetId, jour])
  @@map("disponibilites")
}

/// Congés et absences. Se soustraient des créneaux proposés, et des heures
/// comptées comme travaillées.
model Indisponibilite {
  id    String   @id @default(cuid())
  debut DateTime
  fin   DateTime
  motif String?

  @@index([debut, fin])
  @@map("indisponibilites")
}

enum DemandeStatut {
  EN_ATTENTE
  CONFIRMEE
  REFUSEE
}

/// Demande de rendez-vous déposée depuis le site public par une personne que
/// l'outil ne connaît pas encore.
///
/// Une telle demande est déjà une donnée de santé : solliciter une psychologue
/// en révèle une. Elle est donc traitée comme un dossier — hébergement
/// européen, minimum de champs, et purge de ce qui n'aboutit pas.
model DemandeRdv {
  id        String        @id @default(cuid())
  firstName String        @map("first_name")
  lastName  String        @map("last_name")
  /// Facultative : seul le téléphone est exigé, plus fiable pour reprendre
  /// contact vite. L'e-mail reste demandé — il sert à l'accusé de réception
  /// et au lien de réservation directe — mais son absence ne bloque pas la
  /// demande.
  email     String?
  phone     String
  message   String?
  souhaite  DateTime
  cabinetId String        @map("cabinet_id")
  cabinet   Cabinet       @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  statut    DemandeStatut @default(EN_ATTENTE)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([statut, souhaite])
  @@map("demandes_rdv")
}

model Patient {
  id             String     @id @default(cuid())
  /// Prénom et nom séparés : les vues d'ensemble n'affichent que les
  /// initiales (principe de discrétion), ce qui suppose de les distinguer.
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  email          String?
  phone          String?
  /// Numéros des parents, pour les patients mineurs : c'est souvent eux
  /// qu'on appelle pour déplacer une séance.
  phoneMother    String?    @map("phone_mother")
  phoneFather    String?    @map("phone_father")
  emailMother    String?    @map("email_mother")
  emailFather    String?    @map("email_father")
  /// Numéro de registre national, au format AAMMJJ-XXX.CC (clé vérifiée).
  nationalNumber String?    @map("national_number")
  /// Adresse postale, en champs séparés : un reçu doit pouvoir la composer
  /// proprement, ce qu'une chaîne unique ne permet pas.
  addressLine    String?    @map("address_line")
  postalCode     String?    @map("postal_code")
  city           String?
  birthDate      DateTime?  @map("birth_date")
  scheme         CareScheme
  /// Tarif choisi dans la grille (Réglages → Tarifs) : c'est lui qui fait foi
  /// pour le montant d'une séance.
  tarifId        String?    @map("tarif_id")
  tarif          Tarif?     @relation(fields: [tarifId], references: [id], onDelete: SetNull)
  /// Ancien montant libre, en centimes, d'avant la grille. Sans tarif choisi, il
  /// continue de servir plutôt que de faire disparaître un montant ; dès qu'un
  /// tarif est choisi dans la fiche, il est effacé.
  feeCents       Int?       @map("fee_cents")
  /// Cabinet habituel, simple valeur par défaut à la création d'une séance.
  cabinetId      String?    @map("cabinet_id")
  cabinet        Cabinet?   @relation(fields: [cabinetId], references: [id], onDelete: SetNull)
  notes          String?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  /// Jeton personnel permettant de réserver directement depuis le site, sans
  /// passer par une demande. Il est transmis par courriel, vaut reconnaissance
  /// du patient, et se régénère si besoin.
  jetonRdv String? @unique @map("jeton_rdv")

  sessions     Session[]
  patientNotes Note[]

  @@index([lastName, firstName])
  @@map("patients")
}

model Session {
  id              String                @id @default(cuid())
  /// Nul pour un bloc facturé à un établissement (l'école) : ce temps-là
  /// n'appartient à aucun patient précis, seulement au lieu — voir
  /// Cabinet.factureInstitution. Toute séance qui reçoit quelqu'un
  /// nommément, elle, en a un.
  patientId       String?               @map("patient_id")
  patient         Patient?              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  startsAt        DateTime              @map("starts_at")
  /// Cabinet où se tient la séance. Deux séances consécutives dans des
  /// cabinets différents sans temps de trajet sont signalées à l'écran :
  /// c'est le principal risque d'agenda d'une pratique sur plusieurs sites.
  cabinetId       String                @map("cabinet_id")
  cabinet         Cabinet               @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  /// Durée en minutes plutôt qu'une heure de fin : c'est ainsi qu'une
  /// praticienne raisonne, et ça simplifie les séries récurrentes à venir.
  /// Quarante-cinq minutes est la durée d'une séance dans cette pratique.
  durationMin     Int                   @default(45) @map("duration_min")
  status          SessionStatus         @default(SCHEDULED)
  paymentStatus   PaymentStatus         @default(DUE) @map("payment_status")
  /// Montant figé au moment de la séance : le tarif du patient peut changer
  /// ensuite sans réécrire l'historique comptable.
  amountCents     Int?                  @map("amount_cents")
  paidAt          DateTime?             @map("paid_at")
  paymentMethod   PaymentMethod?        @map("payment_method")
  /// Date d'émission du reçu, pour ne pas en délivrer deux fois sans le savoir.
  receiptAt       DateTime?             @map("receipt_at")
  /// Facture d'établissement qui couvre cette séance, s'il y en a une. Une
  /// fois posé, ce lien fige la séance : elle ne peut plus glisser dans une
  /// autre facture, et la facture déjà émise ne bouge plus si la séance est
  /// modifiée ensuite (voir FactureEtablissement).
  factureId       String?               @map("facture_id")
  facture         FactureEtablissement? @relation(fields: [factureId], references: [id], onDelete: SetNull)
  /// Vrai si la séance a été prise par le patient depuis le site.
  reserveeEnLigne Boolean               @default(false) @map("reservee_en_ligne")
  /// Note clinique. Chiffrement applicatif à venir (le chiffrement de bout en
  /// bout a été écarté, voir les arbitrages du brief) : ce champ restera vide
  /// tant que ce chiffrement n'est pas en place.
  note            String?
  /// Lien avec l'événement Google Agenda correspondant, s'il y en a un.
  /// Identifiant déterministe côté Google (voir lib/google-sync.ts) : un
  /// envoi rejoué après une coupure retombe sur le même événement au lieu de
  /// le dupliquer.
  googleEventId   String?               @unique @map("google_event_id")
  /// Dernier état de l'événement connu de nous. S'il diffère de celui que
  /// Google renvoie, c'est quelqu'un d'autre qui l'a modifié.
  googleEtag      String?               @map("google_etag")
  /// Empreinte de ce que nous avons envoyé (titre, lieu, horaire) : elle
  /// remplace une date de dernière modification, et rend l'envoi idempotent
  /// quel que soit le chemin par lequel la séance a changé.
  googleEmpreinte String?               @map("google_empreinte")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([startsAt])
  @@index([patientId, startsAt])
  @@index([cabinetId, startsAt])
  @@map("sessions")
}

/// Notes libres attachées au dossier, datées et empilées plutôt que réécrites :
/// un dossier se lit dans le temps.
///
/// Le champ reste en clair pour l'instant. Le chiffrement applicatif prévu par
/// le brief n'est pas encore en place ; tant qu'il ne l'est pas, cette
/// instance ne doit recevoir aucune note clinique réelle.
model Note {
  id        String   @id @default(cuid())
  patientId String   @map("patient_id")
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([patientId, createdAt])
  @@map("notes")
}

/// Paramètres de la pratique, en une seule ligne.
///
/// Ils gouvernent le calcul des créneaux proposés au public. Ils étaient
/// jusqu'ici des constantes dans le code : la durée d'une séance, le temps de
/// trajet entre deux lieux, le pas des propositions. Autant de valeurs qui
/// appartiennent à la praticienne et non au programme.
model Parametres {
  id String @id @default("global")

  /// Durée d'une séance, en minutes.
  dureeSeanceMin  Int     @default(45) @map("duree_seance_min")
  /// Battement laissé entre deux séances consécutives dans le même lieu.
  battementMin    Int     @default(0) @map("battement_min")
  /// Temps de trajet minimal entre deux lieux différents.
  trajetMin       Int     @default(30) @map("trajet_min")
  /// Pas de la grille des créneaux proposés.
  pasMin          Int     @default(15) @map("pas_min")
  /// Nombre de semaines ouvertes à la réservation.
  horizonSemaines Int     @default(4) @map("horizon_semaines")
  /// Si vrai, un créneau est aussi proposé juste après une séance existante,
  /// battement compris — l'agenda se tasse au lieu de laisser des trous que la
  /// grille seule ne saurait combler.
  chainerSeances  Boolean @default(true) @map("chainer_seances")

  /// Mentions légales de la SRL, reprises sur toute facture émise à un
  /// établissement. Un reçu au patient n'en a pas besoin — ce n'est pas une
  /// pièce comptable numérotée — mais une facture en est une.
  numeroEntreprise   String? @map("numero_entreprise")
  /// N° INAMI de la praticienne, repris sur le reçu patient (que la mutuelle
  /// demande pour un remboursement) et dans les mentions légales du site.
  numeroInami        String? @map("numero_inami")
  /// N° de visa délivré par le SPF Santé publique : il autorise le titre de
  /// psychologue clinicien. Affiché dans le pied de page du site, les mentions
  /// légales et le reçu patient.
  numeroVisa         String? @map("numero_visa")
  /// N° d'inscription à la Commission des psychologues. Distinct du visa, et
  /// renouvelé chaque année : il est affiché tel quel, sans date.
  numeroCommission   String? @map("numero_commission")
  /// Interrupteur des rendez-vous en ligne. Fermé : la page publique de
  /// réservation affiche un message au lieu des créneaux, et aucune demande
  /// n'est acceptée, même par un formulaire envoyé à la main.
  rdvEnLigne         Boolean @default(true) @map("rdv_en_ligne")
  /// Message affiché quand les rendez-vous sont fermés (facultatif : un texte
  /// par défaut sert à défaut).
  rdvMessage         String? @map("rdv_message")
  iban               String?
  /// Délai de paiement en jours, pour calculer l'échéance à l'émission.
  delaiPaiementJours Int     @default(30) @map("delai_paiement_jours")
  /// Adresse du siège social, reprise en en-tête de toute facture émise à un
  /// établissement — une idée par ligne, ce n'est pas un champ structuré.
  adresseSiege       String? @map("adresse_siege") @db.Text
  /// Mention légale complémentaire de la société (RPM…), reprise sous son
  /// numéro d'entreprise sur la facture.
  mentionLegale      String? @map("mention_legale")

  @@map("parametres")
}

/// Facture émise à un établissement (l'école, aujourd'hui la seule) pour un
/// mois de vacations.
///
/// À la différence du reçu au patient — une pièce informelle, sans
/// numérotation — c'est ici une pièce comptable au sens plein : la loi belge
/// impose une numérotation continue et chronologique des factures de vente,
/// une seule séquence pour toute la société, jamais un trou ni une remise à
/// zéro par client. `numero` est donc unique par année civile
/// (`@@unique([annee, numero])`), jamais par établissement.
///
/// Les montants sont figés à l'émission (tarif horaire, heures, montant) :
/// une facture déjà envoyée ne doit plus changer parce qu'une séance a été
/// corrigée après coup. C'est la raison d'être de ce modèle plutôt qu'un
/// simple recalcul à la volée depuis les séances.
model FactureEtablissement {
  id                String    @id @default(cuid())
  cabinetId         String    @map("cabinet_id")
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  annee             Int
  numero            Int
  /// Mois couvert par la facture (1-12).
  mois              Int
  /// Nulles pour une facture manuelle (manuelle = vrai) : un montant saisi
  /// directement n'a pas de décompte d'heures à présenter.
  heuresTotalesMin  Int?      @map("heures_totales_min")
  tarifHoraireCents Int?      @map("tarif_horaire_cents")
  montantCents      Int       @map("montant_cents")
  /// Description libre, affichée sur le PDF à la place du décompte d'heures.
  /// Attendue si manuelle est vrai ; sinon dérivée automatiquement.
  libelle           String?
  /// Note interne, jamais imprimée sur le PDF — le contexte d'une
  /// régularisation, à l'usage de la praticienne seule.
  commentaire       String?   @db.Text
  /// Vrai si créée à la main plutôt que calculée depuis les séances de
  /// l'établissement — un supplément ponctuel, par exemple.
  manuelle          Boolean   @default(false)
  emiseLe           DateTime  @default(now()) @map("emise_le")
  echeanceLe        DateTime  @map("echeance_le")
  /// Null tant que l'établissement n'a pas réglé.
  payeeLe           DateTime? @map("payee_le")
  /// Annulée plutôt que supprimée : la numérotation légale ne tolère pas de
  /// trou, une facture qui ne doit plus valoir se marque, elle ne disparaît
  /// pas. Ses séances repartent à factureId nul, prêtes pour une prochaine
  /// facture. Seule une facture non payée peut être annulée (voir
  /// annulerFactureEtablissement) — au-delà, la correction relève de la
  /// comptable.
  annuleeLe         DateTime? @map("annulee_le")

  seances Session[]

  @@unique([annee, numero])
  @@index([cabinetId, annee, mois])
  @@map("factures_etablissement")
}

/// Catégories d'une dépense professionnelle. Des données, pas une énumération
/// figée dans le code — comme les cabinets et les tarifs : la praticienne
/// doit pouvoir en ajouter une (Horeca, par exemple) sans migration ni
/// déploiement, depuis Réglages.
model CategorieDepense {
  id      String  @id @default(cuid())
  libelle String  @unique
  actif   Boolean @default(true)
  ordre   Int     @default(0)

  depenses Depense[]

  @@map("categories_depense")
}

/// Une dépense professionnelle, avec la photo de son reçu.
///
/// Symétrique du reçu délivré au patient (Session.receiptAt, /api/recu) mais
/// dans l'autre sens : ce que la praticienne reçoit, pas ce qu'elle émet.
/// Photographiée au comptoir plutôt qu'agrafée à un classeur — c'est le geste
/// qui remplace la boîte à chaussures.
///
/// Le fichier est gardé en base (Bytes) plutôt que sur un stockage à part :
/// au volume d'une pratique individuelle, une dépense par jour ouvré tout au
/// plus, ça ne pèse rien, et ça évite une dépendance externe pour un premier
/// jet. À revoir si le volume change.
model Depense {
  id          String           @id @default(cuid())
  date        DateTime
  libelle     String
  categorieId String           @map("categorie_id")
  categorie   CategorieDepense @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  fournisseur String?
  /// TTC : la praticienne n'étant pas assujettie à la TVA sur ses
  /// prestations, elle ne la récupère pas davantage sur ses achats.
  amountCents Int              @map("amount_cents")
  /// Rattachement facultatif à un lieu, pour ventiler une charge qui lui est
  /// propre (loyer d'un cabinet). Une dépense commune aux deux n'en a pas.
  cabinetId   String?          @map("cabinet_id")
  cabinet     Cabinet?         @relation(fields: [cabinetId], references: [id], onDelete: SetNull)
  photo       Bytes?
  photoMime   String?          @map("photo_mime")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([date])
  @@map("depenses")
}

/// Connexion unique au Google Agenda d'Amandine.
///
/// Le jeton de rafraîchissement donne accès à son agenda : il n'est jamais
/// stocké en clair (AES-256-GCM, clé GOOGLE_TOKEN_KEY hors base).
model GoogleConnexion {
  id                  String    @id @default("global")
  email               String
  refreshTokenChiffre String    @map("refresh_token_chiffre") @db.Text
  /// « primary » : l'agenda principal du compte.
  calendrierId        String    @default("primary") @map("calendrier_id")
  /// Curseur de synchronisation incrémentale de Google ; nul = tout relire.
  syncToken           String?   @map("sync_token") @db.Text
  derniereSynchro     DateTime? @map("derniere_synchro")
  derniereErreur      String?   @map("derniere_erreur") @db.Text
  /// Verrou léger : deux synchronisations simultanées dupliqueraient des
  /// événements. Expire de lui-même si une exécution meurt en route.
  verrouJusqua        DateTime? @map("verrou_jusqua")
  creeLe              DateTime  @default(now()) @map("cree_le")

  @@map("google_connexions")
}

enum StatutEvenementGoogle {
  /// Arrivé de Google, en attente d'une décision : séance, ou simple créneau pris.
  A_RATTACHER
  /// Créneau pris : affiché, il bloque la réservation en ligne, sans être une
  /// séance ni facturable.
  OCCUPE
  /// Ni affiché ni bloquant.
  IGNORE
}

/// Événement créé dans Google Agenda qui n'est pas (encore) une séance.
/// Une fois rattaché à un patient ou à un lieu, il devient une Session et
/// cette ligne disparaît.
model EvenementGoogle {
  id       String                @id @default(cuid())
  googleId String                @unique @map("google_id")
  etag     String?
  titre    String
  lieu     String?
  debut    DateTime
  fin      DateTime
  statut   StatutEvenementGoogle @default(A_RATTACHER)
  /// Série d'événements récurrents dont celui-ci est une occurrence : on les
  /// rattache d'un coup plutôt qu'un par un.
  serieId  String?               @map("serie_id")
  majLe    DateTime              @updatedAt @map("maj_le")

  @@index([debut])
  @@index([serieId])
  @@map("evenements_google")
}
